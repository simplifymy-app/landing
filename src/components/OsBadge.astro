---
import type { App } from 'consts';

interface Props {
  app: App;
  small?: boolean;
}

const { app, small = false } = Astro.props;

const NAMES = { android: 'Android', macos: 'macOS', windows: 'Windows' } as const;
---

{app.platforms.map((platform) => (
  <span class:list={['badge', 'badge-os', 'os', { 'badge-sm': small }]}>
    {platform === 'android' && (
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M17.523 15.341a.999.999 0 1 1 0-1.999.999.999 0 0 1 0 1.999m-11.046 0a.999.999 0 1 1 0-1.999.999.999 0 0 1 0 1.999m11.405-6.02 1.997-3.459a.416.416 0 0 0-.152-.568.416.416 0 0 0-.568.152l-2.022 3.503C15.59 8.244 13.853 7.851 12 7.851s-3.59.393-5.137 1.099L4.841 5.447a.416.416 0 0 0-.568-.152.416.416 0 0 0-.152.568l1.997 3.459C2.689 11.187.343 14.659 0 18.761h24c-.344-4.102-2.689-7.574-6.118-9.44" />
      </svg>
    )}
    {platform === 'macos' && (
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M12.152 6.896c-.948 0-2.415-1.078-3.96-1.04-2.04.027-3.91 1.183-4.961 3.014-2.117 3.675-.546 9.103 1.519 12.09 1.013 1.454 2.208 3.09 3.792 3.039 1.52-.065 2.09-.987 3.935-.987 1.831 0 2.35.987 3.96.948 1.637-.026 2.676-1.48 3.676-2.948 1.156-1.688 1.636-3.325 1.662-3.415-.039-.013-3.182-1.221-3.22-4.857-.026-3.04 2.48-4.494 2.597-4.559-1.429-2.09-3.623-2.324-4.39-2.376-2-.156-3.675 1.09-4.61 1.09zM15.53 3.83c.843-1.012 1.4-2.427 1.245-3.83-1.207.052-2.662.805-3.532 1.818-.78.896-1.454 2.338-1.273 3.714 1.338.104 2.715-.688 3.559-1.701" />
      </svg>
    )}
    {platform === 'windows' && (
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M0 3.449 9.75 2.1v9.451H0m10.949-9.602L24 0v11.4H10.949M0 12.6h9.75v9.451L0 20.699M10.949 12.6H24V24l-12.9-1.801" />
      </svg>
    )}
    <span class="sr-only">{NAMES[platform]}</span>
  </span>
))}

<style>
  .os { width: 22px; padding: 0; justify-content: center; }
  .os svg { width: 13px; height: 13px; display: block; fill: currentColor; }
  .os.badge-sm { width: 18px; }
  .os.badge-sm svg { width: 11px; height: 11px; }
</style>
