---
// The five app accents, each with a deeper stop so a tile reads as a lit surface.
const PALETTE = [
  ['#718CFF', '#5A70CC'], // blue
  ['#DEA858', '#B18646'], // amber
  ['#61BF8D', '#4D9870'], // green
  ['#D96B8B', '#AD556F'], // pink
  ['#AD8DFF', '#8A70CC'], // purple
];

/*
  Four drifting columns of gradient tiles. Each column runs the whole palette, started at
  a different point in it, so no two neighbours show the same colour side by side; each
  set is then duplicated for the loop.
*/
const COLUMNS = [
  { anim: 'driftUp 34s', start: 0 },
  { anim: 'driftDown 42s', start: 2 },
  { anim: 'driftUp 28s', start: 4 },
  { anim: 'driftDown 38s', start: 1 },
].map(({ anim, start }) => ({
  anim,
  tiles: PALETTE.map((_, i) => PALETTE[(start + i) % PALETTE.length]),
}));
---

<div class="graphic" aria-hidden="true">
  <div class="columns">
    {COLUMNS.map(({ anim, tiles }) => (
      <div class="column" style={`animation: ${anim} linear infinite;`}>
        {[...tiles, ...tiles].map(([from, to]) => (
          <div class="tile" style={`background: linear-gradient(150deg, ${from}, ${to});`}></div>
        ))}
      </div>
    ))}
  </div>
  <div class="fade"></div>
</div>

<style>
  .graphic {
    position: relative;
    height: 560px;
    overflow: hidden;
    align-self: stretch;
    margin-right: calc(-1 * var(--gutter));
  }
  .columns {
    position: absolute;
    inset: -14% -6% -14% 2%;
    display: flex;
    gap: 12px;
    transform: rotate(-13deg);
  }
  .column { flex: 1; display: flex; flex-direction: column; gap: 12px; will-change: transform; }
  .tile { aspect-ratio: 1; border-radius: var(--r-tile); }
  .fade {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(90deg, var(--bg) 0%, rgba(0, 0, 0, 0) 34%),
      linear-gradient(0deg, var(--bg) 0%, rgba(0, 0, 0, 0) 22%, rgba(0, 0, 0, 0) 78%, var(--bg) 100%);
  }

  @keyframes driftUp { from { transform: translateY(0); } to { transform: translateY(-50%); } }
  @keyframes driftDown { from { transform: translateY(-50%); } to { transform: translateY(0); } }

  @media (max-width: 860px) {
    .graphic { height: 340px; margin: 0 calc(-1 * var(--gutter)); }
  }

  @media (prefers-reduced-motion: reduce) {
    .column { animation-play-state: paused !important; }
  }
</style>
