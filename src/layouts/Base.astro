---
import { ClientRouter } from 'astro:transitions';
import { SEO } from 'astro-seo';
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';

import Header from 'components/Header.astro';
import Footer from 'components/Footer.astro';
import { LANG, LOCALE, SITE } from 'consts';
import { PAGES, ogImagePath, type PageKey } from '../lib/pages';
import { buildSchema, type SchemaOptions } from '../lib/schema';
import 'styles/global.css';

import headingFont from '@fontsource/space-grotesk/files/space-grotesk-latin-600-normal.woff2?url';

interface Props {
  title: string;
  description: string;
  page?: PageKey;
  noindex?: boolean;
  trail?: SchemaOptions['trail'];
  pageType?: SchemaOptions['pageType'];
  apps?: boolean;
  app?: SchemaOptions['app'];
  faq?: boolean;
}

const {
  title,
  description,
  page,
  noindex = false,
  trail,
  pageType,
  apps = false,
  app,
  faq = false,
} = Astro.props;

const path = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonical = new URL(path, Astro.site).href;

const ogImage = new URL(page ? ogImagePath(page) : '/og.png', Astro.site).href;
const fullTitle = `${title} — ${SITE}`;

const schema = noindex
  ? null
  : buildSchema({
      path: page ? PAGES[page].path : path,
      title: fullTitle,
      description,
      trail,
      pageType,
      apps,
      app,
      faq,
      image: ogImage,
    });
---

<!doctype html>
<html lang={LANG}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <SEO
      title={fullTitle}
      description={description}
      canonical={canonical}
      noindex={noindex}
      nofollow={noindex}
      robotsExtras={
        noindex
          ? undefined
          : 'max-snippet:-1, max-image-preview:large, max-video-preview:-1'
      }
      openGraph={{
        basic: { title: fullTitle, type: 'website', image: ogImage, url: canonical },
        optional: { siteName: SITE, description, locale: LOCALE },
        image: {
          url: ogImage,
          type: 'image/png',
          width: 1200,
          height: 630,
          alt: `${title} — ${SITE}`,
        },
      }}
      twitter={{
        card: 'summary_large_image',
        title: fullTitle,
        description,
        image: ogImage,
        imageAlt: `${title} — ${SITE}`,
      }}
      extend={{
        meta: [
          { name: 'author', content: SITE },
          { name: 'application-name', content: SITE },
          { name: 'apple-mobile-web-app-title', content: SITE },
          { name: 'theme-color', content: '#0B0B0C' },
        ],
        link: [
          { rel: 'icon', href: '/favicon.svg', type: 'image/svg+xml' },
          { rel: 'apple-touch-icon', href: '/apple-touch-icon.png', sizes: '180x180' },
          { rel: 'manifest', href: '/site.webmanifest' },
          {
            rel: 'preload',
            as: 'font',
            type: 'font/woff2',
            crossorigin: 'anonymous',
            href: headingFont,
          },
        ],
      }}
    />

    {schema && (
      <script
        type="application/ld+json"
        is:inline
        set:html={JSON.stringify(schema)}
      />
    )}

    <ClientRouter />
    <script is:inline>
      (() => {
        let t = null;
        try { t = localStorage.getItem('simplify-site-theme'); } catch {}
        if (t !== 'light' && t !== 'dark') {
          t = matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
        }
        document.documentElement.dataset.theme = t;

        document.addEventListener('astro:before-swap', (e) => {
          e.newDocument.documentElement.dataset.theme = document.documentElement.dataset.theme;
        });
      })();
    </script>
  </head>
  <body>
    <Header />
    <slot />
    <Footer />
    <Analytics />
    <SpeedInsights />
  </body>
</html>
