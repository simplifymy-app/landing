---
import { Image } from 'astro:assets';
import Base from 'layouts/Base.astro';
import DownloadCta from 'components/DownloadCta.astro';
import { DESKTOP_APPS } from 'consts';

import shotEditor from 'assets/shot-editor.png';
import shotEditorLight from 'assets/shot-editor-light.png';
import shotCapture from 'assets/shot-capture.png';
import shotCaptureLight from 'assets/shot-capture-light.png';
import shotBackdrop from 'assets/shot-backdrop.png';
import shotBackdropLight from 'assets/shot-backdrop-light.png';
import shotSettings from 'assets/shot-settings.png';
import shotSettingsLight from 'assets/shot-settings-light.png';

const SHOT = DESKTOP_APPS[0];

// Four abstractions of what the app does, each running the motion of the thing itself:
// a marquee closing on a selection, an arrow drawn, a line of text read, a shot pinned.
const DOES = [
  { mini: 'marquee', title: 'Capture', body: 'Area, window, fullscreen, delayed — or a scrolling page stitched back into one image.', tint: ['#718CFF', '#5A70CC'] },
  { mini: 'arrow', title: 'Annotate', body: 'Arrows, shapes, text, counters, freehand, highlighter, blur. Every object stays editable.', tint: ['#AD8DFF', '#8A70CC'] },
  { mini: 'read', title: 'Read', body: 'Pull the text out of any screenshot, decode a QR code, lift a colour in HEX, RGB, HSL or OKLCH.', tint: ['#DEA858', '#B18646'] },
  { mini: 'pin', title: 'Keep', body: 'Pin a shot on top of everything, or drop it on a backdrop and export it finished.', tint: ['#61BF8D', '#4D9870'] },
];

const FEATURES = [
  'Area, window, fullscreen and delayed capture',
  'Scrolling capture, stitched by overlap',
  'Arrows, shapes, text, counters, freehand',
  'Blur and pixelate: area, text-only or erase',
  'Ruler and guides that imprint measurements',
  'Colour picker: HEX, RGB, HSL, OKLCH',
  'Contrast checker with WCAG and APCA',
  'Text recognition and QR decoding',
  'Pin a shot above every other window',
  'Backdrop: gradient, padding, shadow, corners',
  'Undo everything; the original is never touched',
  'Light, dark and pure black, five accents',
];

const SHOTS = [
  { dark: shotEditor, light: shotEditorLight, alt: 'Simplify my Shot editor for macOS with an arrow, a rounded rectangle and a counter placed on a screenshot' },
  { dark: shotCapture, light: shotCaptureLight, alt: 'Area capture in Simplify my Shot: the screen dimmed behind a selection with a live size readout' },
  { dark: shotBackdrop, light: shotBackdropLight, alt: 'The backdrop tool in Simplify my Shot putting a screenshot on a gradient with padding and a shadow' },
  { dark: shotSettings, light: shotSettingsLight, alt: 'Hotkey settings in Simplify my Shot for macOS' },
];
---

<Base
  page="desktop"
  title="Desktop — Simplify my Shot"
  description="Simplify my Shot: screenshots, annotation, measurement and text recognition for macOS and Windows. Free, no account, no tracking, nothing uploaded."
  pageType="CollectionPage"
  trail={[{ name: 'Desktop', path: '/desktop/' }]}
  desktop
>
  <main class="shell">
    <section class="intro">
      <div class="copy">
        <div class="kicker">Desktop · 01</div>
        <h1 class="page-h1">The same idea, on the desktop.</h1>
        <p class="lede">A screenshot tool should take the picture, let you mark it up and get out of the way. This one does that on macOS and Windows — free, with no account, no upload and nothing collected.</p>
      </div>

      <div class="does">
        {DOES.map((item, i) => (
          <div class="cell" style={`--from: ${item.tint[0]}; --to: ${item.tint[1]}; --d: ${120 + i * 90}ms;`}>
            <span class="tile" aria-hidden="true">
              {item.mini === 'marquee' && (
                <span class="mini marquee">
                  <span class="frame"></span>
                  {[0, 1, 2, 3].map((n) => <span class="handle" style={`--i: ${n}`}></span>)}
                </span>
              )}
              {item.mini === 'arrow' && (
                <span class="mini arrow">
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path class="shaft" d="M3 21 L19 5" />
                    <path class="head" d="M11 5h8v8" />
                  </svg>
                </span>
              )}
              {item.mini === 'read' && (
                <span class="mini read">
                  {[0, 1, 2, 3].map((n) => <span class="line" style={`--i: ${n}`}></span>)}
                  <span class="scan"></span>
                </span>
              )}
              {item.mini === 'pin' && (
                <span class="mini pin">
                  <span class="sheet back"></span>
                  <span class="sheet front"></span>
                </span>
              )}
            </span>
            <div class="cell-title">{item.title}</div>
            <div class="cell-body">{item.body}</div>
          </div>
        ))}
      </div>
    </section>

    <section class="app" id={SHOT.slug}>
      <div class="head">
        <h2>{SHOT.fullName}</h2>
        <span class="meta">Screenshots · {SHOT.os}</span>
      </div>

      <p class="desc">Take the shot, say what matters on it, and move on. Drag out an area, grab a window with its shadow, or let it scroll a long page and stitch the frames back together. Then arrows, boxes, numbered steps, a blur over what should not be in the picture, and a ruler that writes the measurement into the image. It reads the text out of a screenshot too, so a number on screen becomes a number you can paste.</p>
      <p class="desc">There is no account, no library in the cloud and no upload. A screenshot is a file on your disk, which is what it always was.</p>

      <div class="get">
        <DownloadCta browse="/download/" />
        <p class="get-note">Free. No account, no upload — and it keeps itself up to date after the first install.</p>
      </div>

      <ul class="features">
        {FEATURES.map((f) => <li>{f}</li>)}
      </ul>

      <div class="shots">
        {SHOTS.map(({ dark, light, alt }) => (
          <figure>
            <Image src={dark} alt={alt} width={1120} densities={[1, 2]} loading="lazy" class="shot-dark" />
            {/* The same screen in the light theme; CSS shows one or the other, so this
                copy is decorative and must not be announced twice. */}
            <Image src={light} alt="" width={1120} densities={[1, 2]} loading="lazy" class="shot-light" />
          </figure>
        ))}
      </div>
      <div class="caption">Interface previews drawn from the build in progress — macOS shown, Windows is the same app.</div>

      <div class="ask">
        <div class="ask-copy">Built on the same design system as the phone apps.<br />Tell me what a screenshot tool must have and it goes in before release.</div>
        <a href="/contact/" class="btn btn-accent">Request a feature</a>
      </div>
    </section>
  </main>
</Base>

<style>
  .intro { padding: 35px 0 44px; }
  .intro .kicker { display: block; margin-bottom: 22px; }
  .page-h1 { max-width: 17ch; }
  .lede { max-width: 58ch; }

  /*
    The four things the app does, each as a tile in its own colour running a small loop of
    that thing: a marquee closing on a selection, an arrow drawn, a line of text read, one
    shot lifted above another.
  */
  .does {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 26px;
    margin-top: 40px;
  }
  .cell { animation: rise var(--t-enter) var(--enter) var(--d) backwards; }
  .tile {
    position: relative;
    display: grid;
    place-items: center;
    width: 64px;
    aspect-ratio: 1;
    margin-bottom: 16px;
    border-radius: var(--r-tile);
    background: linear-gradient(150deg, var(--from), var(--to));
    overflow: hidden;
  }
  .cell-title { font-size: 17px; font-weight: 600; letter-spacing: -0.02em; margin-bottom: 8px; }
  .cell-body { font-size: 14px; line-height: 1.6; color: var(--text-muted); }

  .mini { position: relative; width: 50%; height: 50%; }

  /* Marquee: the frame closes in, holds on the selection, then opens again. */
  .frame {
    position: absolute;
    inset: 0;
    border: 1.5px solid rgba(255, 255, 255, 0.95);
    border-radius: 2px;
    animation: marquee 3.2s var(--enter) infinite;
  }
  .handle {
    position: absolute;
    width: 4px;
    height: 4px;
    background: #fff;
    border-radius: 1px;
    animation: marquee-dot 3.2s var(--enter) infinite;
  }
  /* --i walks the four corners: 0 TL, 1 TR, 2 BR, 3 BL. */
  .handle:nth-child(2) { top: -2px; left: -2px; }
  .handle:nth-child(3) { top: -2px; right: -2px; }
  .handle:nth-child(4) { bottom: -2px; right: -2px; }
  .handle:nth-child(5) { bottom: -2px; left: -2px; }
  @keyframes marquee {
    0%, 8% { transform: scale(0.3); opacity: 0.5; }
    38%, 74% { transform: scale(1); opacity: 1; }
    96%, 100% { transform: scale(0.3); opacity: 0.5; }
  }
  @keyframes marquee-dot {
    0%, 30% { opacity: 0; }
    42%, 74% { opacity: 1; }
    88%, 100% { opacity: 0; }
  }

  /* Arrow: the shaft draws itself, then the head arrives. */
  .arrow svg { width: 100%; height: 100%; overflow: visible; }
  .arrow path {
    fill: none;
    stroke: rgba(255, 255, 255, 0.95);
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .arrow .shaft { stroke-dasharray: 24; animation: draw 2.8s var(--enter) infinite; }
  .arrow .head { stroke-dasharray: 16; animation: draw-head 2.8s var(--enter) infinite; }
  @keyframes draw {
    0% { stroke-dashoffset: 24; }
    45%, 82% { stroke-dashoffset: 0; }
    100% { stroke-dashoffset: 24; }
  }
  @keyframes draw-head {
    0%, 42% { stroke-dashoffset: 16; }
    62%, 82% { stroke-dashoffset: 0; }
    100% { stroke-dashoffset: 16; }
  }

  /* Read: a scan line passes and the lines it has crossed stay lit. */
  .read { display: grid; align-content: center; gap: 18%; overflow: hidden; }
  .line {
    height: 2.5px;
    border-radius: 1.25px;
    background: rgba(255, 255, 255, 0.4);
    animation: lit 3s var(--enter) calc(var(--i) * 260ms) infinite;
  }
  .line:nth-child(2) { width: 100%; }
  .line:nth-child(3) { width: 72%; }
  .line:nth-child(4) { width: 88%; }
  .line:nth-child(5) { width: 54%; }
  @keyframes lit { 0%, 100% { background: rgba(255, 255, 255, 0.35); } 30% { background: rgba(255, 255, 255, 1); } }
  .scan {
    position: absolute;
    left: -10%;
    right: -10%;
    height: 1.5px;
    background: rgba(255, 255, 255, 0.9);
    animation: scan 3s linear infinite;
  }
  @keyframes scan { 0% { top: -6%; } 70%, 100% { top: 104%; } }

  /* Keep: the front sheet lifts off the back one and settles again. */
  .pin .sheet {
    position: absolute;
    width: 74%;
    height: 74%;
    border-radius: 2px;
  }
  .pin .back { right: 0; bottom: 0; border: 1.5px solid rgba(255, 255, 255, 0.5); }
  .pin .front {
    left: 0;
    top: 0;
    background: rgba(255, 255, 255, 0.95);
    animation: lift 3.4s var(--enter) infinite;
  }
  @keyframes lift {
    0%, 16% { transform: none; }
    46%, 72% { transform: translate(-9%, -9%); }
    94%, 100% { transform: none; }
  }

  /* scroll-margin clears the sticky header when something links straight to the app. */
  .app { padding: 40px 0 80px; border-top: 1px solid var(--hairline); scroll-margin-top: 84px; }

  .head { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; }
  h2 { margin: 0; font-size: 34px; line-height: 1.1; font-weight: 600; letter-spacing: -0.03em; }
  /* Meta shares the name's centre line, so the two sit level. */
  .meta {
    display: inline-flex;
    align-items: center;
    height: 22px;
    font-family: var(--mono);
    font-size: 11.5px;
    line-height: 1;
    color: var(--text-faint);
  }

  .desc { margin: 18px 0 0; font-size: 16px; line-height: 1.65; color: var(--text-muted); max-width: 62ch; }

  .get { margin: 30px 0 4px; }
  .get-note { margin: 12px 0 0; font-size: 13.5px; line-height: 1.5; color: var(--text-faint); }

  .features {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 12px 34px;
    margin: 30px 0 34px;
    padding: 0;
    list-style: none;
  }
  .features li { font-size: 14.5px; line-height: 1.55; }

  /*
    Desktop captures are wide, so they go two to a row rather than into the phone apps'
    side-scrolling strip. Each one already carries its own shadow, so nothing is drawn
    around them.
  */
  .shots { display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; }
  .shots figure { margin: 0; min-width: 0; }
  .shots :global(img) { width: 100%; height: auto; }
  /* A shot pairs a dark and a light render; the site's theme picks which one is shown. */
  .shots :global(.shot-light) { display: none; }
  :global([data-theme='light']) .shots :global(.shot-light) { display: block; }
  :global([data-theme='light']) .shots :global(.shot-dark) { display: none; }
  .caption { font-family: var(--mono); font-size: 11.5px; color: var(--text-faint); margin-top: 12px; }

  .ask {
    margin-top: 34px;
    border: 1px solid var(--hairline);
    border-radius: var(--r-card);
    padding: 22px;
    display: flex;
    gap: 20px;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
  }
  .ask-copy { font-family: var(--mono); font-size: 12px; line-height: 1.7; color: var(--text-muted); }

  /* The header wraps to two rows below 720px, so the anchor clears a taller bar. */
  @media (max-width: 720px) {
    .app { scroll-margin-top: 110px; }
    .does { grid-template-columns: repeat(2, 1fr); gap: 28px 22px; }
  }

  @media (max-width: 560px) {
    .intro { padding: 35px 0 40px; }
    .does { grid-template-columns: 1fr; gap: 26px; }
    .tile { width: 52px; margin-bottom: 12px; }
    h2 { font-size: 28px; }
    .features { grid-template-columns: 1fr; }
    .shots { grid-template-columns: 1fr; }
  }

  /* The looping tiles are decoration; nothing here is lost by holding them still. */
  @media (prefers-reduced-motion: reduce) {
    .frame, .handle, .arrow path, .line, .scan, .pin .front { animation: none; }
    .scan { display: none; }
  }
</style>
