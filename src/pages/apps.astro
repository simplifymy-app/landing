---
import { Image } from 'astro:assets';
import Base from 'layouts/Base.astro';

import galleryFolders from 'assets/gallery-folders.png';
import galleryFoldersLight from 'assets/gallery-folders-light.png';
import galleryGrid from 'assets/gallery-grid.png';
import galleryGridLight from 'assets/gallery-grid-light.png';
import galleryEdit from 'assets/gallery-edit.png';
import galleryEditLight from 'assets/gallery-edit-light.png';
import galleryMakeItYours from 'assets/gallery-make-it-yours.png';
import galleryMakeItYoursLight from 'assets/gallery-make-it-yours-light.png';

import playerLibrary from 'assets/player-library.png';
import playerLibraryLight from 'assets/player-library-light.png';
import playerAlbums from 'assets/player-albums.png';
import playerAlbumsLight from 'assets/player-albums-light.png';
import playerNowPlaying from 'assets/player-now-playing.png';
import playerNowPlayingLight from 'assets/player-now-playing-light.png';
import playerMakeItYours from 'assets/player-make-it-yours.png';
import playerMakeItYoursLight from 'assets/player-make-it-yours-light.png';

import recorderLibrary from 'assets/recorder-library.png';
import recorderLibraryLight from 'assets/recorder-library-light.png';
import recorderProject from 'assets/recorder-project.png';
import recorderProjectLight from 'assets/recorder-project-light.png';
import recorderEditor from 'assets/recorder-editor.png';
import recorderEditorLight from 'assets/recorder-editor-light.png';
import recorderSettings from 'assets/recorder-settings.png';
import recorderSettingsLight from 'assets/recorder-settings-light.png';

import filesRoot from 'assets/files-root.png';
import filesRootLight from 'assets/files-root-light.png';
import filesFolder from 'assets/files-folder.png';
import filesFolderLight from 'assets/files-folder-light.png';
import filesMarked from 'assets/files-marked.png';
import filesMarkedLight from 'assets/files-marked-light.png';
import filesSettings from 'assets/files-settings.png';
import filesSettingsLight from 'assets/files-settings-light.png';

const APPS = [
  {
    name: 'Gallery',
    available: true,
    meta: 'Photos & video · Android · under 5 MB',
    description:
      'A photo and video album that reads the pictures already on your phone, lays them out in the real folders they live in, and gets out of the way. The part most gallery apps cannot claim: it does not request the internet permission at all, so it cannot upload a photo, load an ad or phone home — not by promise, by construction. Check the permission list before you trust me.',
    features: [
      'Folder view that mirrors your phone',
      'Group by day or month, five sort keys',
      'Full-screen viewer, pinch zoom, video',
      'Details: size, dimensions, camera, EXIF',
      'Favourites, multi-select, hide folders',
      'Light, dark and pure black themes',
      'Five accents, custom colour, six app icons',
      '2–5 columns, radius, text size, contrast',
    ],
    shots: [
      { dark: galleryFolders, light: galleryFoldersLight, alt: 'Gallery — folders' },
      { dark: galleryGrid, light: galleryGridLight, alt: 'Gallery — a folder by day' },
      { dark: galleryEdit, light: galleryEditLight, alt: 'Gallery — crop and rotate' },
      { dark: galleryMakeItYours, light: galleryMakeItYoursLight, alt: 'Gallery — make it yours' },
    ],
  },
  {
    name: 'Player',
    available: false,
    meta: 'Music · Android · under 5 MB',
    description:
      'A music player for the files already on your phone. It reads them where they sit, plays them in the background with a real notification, lock-screen controls and headset keys, and stops there — no catalogue to browse, no account, no recommendations. Like Gallery, it does not request the internet permission, so the music cannot go anywhere.',
    features: [
      'Tracks, albums, artists and playlists',
      'Background playback, lock screen, headset keys',
      'Queue: play next, add, reorder, shuffle',
      'Swipe the cover to change track, down to close',
      'Favourites, playlists, optional play history',
      'Sleep timer and synced .lrc lyrics',
      'Hide folders you do not want in the library',
      'Same themes, accents and app icons',
    ],
    shots: [
      { dark: playerLibrary, light: playerLibraryLight, alt: 'Player — library' },
      { dark: playerAlbums, light: playerAlbumsLight, alt: 'Player — albums' },
      { dark: playerNowPlaying, light: playerNowPlayingLight, alt: 'Player — now playing' },
      { dark: playerMakeItYours, light: playerMakeItYoursLight, alt: 'Player — make it yours' },
    ],
    caption: 'Screens from the current build in progress.',
  },
  {
    name: 'Recorder',
    available: false,
    meta: 'Audio · Android',
    description:
      "A voice recorder that shows you the sound. Record with a live waveform and a running clock, drop a mark at the moment something matters, then trim, cut and fade afterwards without ever overwriting the original. Recordings are files on your phone in WAV, M4A or OPUS — not entries in someone's cloud.",
    features: [
      'Live waveform, dB meter, mono clock',
      'Marks while recording, 1× / 4× / 16× zoom',
      'Cut, split, fade — undoable until you save',
      'Record straight into a selection',
      'Playback 0.25× to 2×, −15s / +15s',
      'Optional projects, starred takes, search',
      'WAV / M4A / OPUS, voice to studio quality',
      'Same themes, accents and app icons',
    ],
    shots: [
      { dark: recorderLibrary, light: recorderLibraryLight, alt: 'Recorder — library' },
      { dark: recorderProject, light: recorderProjectLight, alt: 'Recorder — a project' },
      { dark: recorderEditor, light: recorderEditorLight, alt: 'Recorder — editor' },
      { dark: recorderSettings, light: recorderSettingsLight, alt: 'Recorder — settings' },
    ],
    caption: 'Screens from the current build in progress.',
  },
  {
    name: 'Files',
    available: false,
    meta: 'File manager · Android',
    description:
      'A two-pane file manager, the way they used to be. Two folders open at once: mark what you want in the active pane, and copy or move goes into the other one. Portrait swipes between the panes; landscape shows both side by side. No file browser wants to be a homepage, so this one is a list, a footer and five buttons.',
    features: [
      'Copy, move, rename, delete, new folder',
      'Undo on the last operation',
      'Internal storage and SD card',
      'Filter, sort, folders-first, hidden files',
      'Comfortable or compact rows, kB or KiB',
      'Free space shown per pane',
    ],
    shots: [
      { dark: filesRoot, light: filesRootLight, alt: 'Files — internal storage' },
      { dark: filesFolder, light: filesFolderLight, alt: 'Files — a folder' },
      { dark: filesMarked, light: filesMarkedLight, alt: 'Files — marked for copy' },
      { dark: filesSettings, light: filesSettingsLight, alt: 'Files — settings' },
    ],
    caption: 'Screens from the current build in progress.',
  },
];
---

<Base
  title="Apps — Simplify my app"
  description="Gallery, Player, Recorder and Files. Free Android apps with no ads, no accounts and no tracking. Gallery is available; the rest are in development."
>
  <main class="shell">
    <section class="intro">
      <div class="kicker">Apps · 04</div>
      <h1 class="page-h1">Apps I use every day.</h1>
      <p class="lede">Android. Free. No ads, no accounts, no tracking, no in-app purchases — in all of them, not just the first one. Gallery is out; Player, Recorder and Files are in development.</p>
    </section>

    {APPS.map((app) => (
      <section class="app" id={app.name.toLowerCase()}>
        <div class="head">
          <h2>{app.name}</h2>
          <span class:list={['badge', app.available ? 'available' : 'dev']}>
            {app.available ? 'Available' : 'In development'}
          </span>
          <span class="meta">{app.meta}</span>
        </div>
        <p class="desc">{app.description}</p>
        <ul class="features">
          {app.features.map((f) => <li>{f}</li>)}
        </ul>
        {app.shots.length > 0 && (
          <div class="shots">
            {app.shots.map(({ dark, light, alt }) => (
              <>
                <Image src={dark} alt={alt} width={416} densities={[1]} loading="lazy" class={light ? 'shot-dark has-light' : 'shot-dark'} />
                {light && <Image src={light} alt={alt} width={416} densities={[1]} loading="lazy" class="shot-light" />}
              </>
            ))}
          </div>
        )}
        {app.caption && <div class="caption">{app.caption}</div>}
        {app.name === 'Files' && (
          <div class="ask">
            <div class="ask-copy">The build runs; the polish is next.<br />Tell me what a file manager must have and it goes in before release.</div>
            <a href="/contact" class="btn btn-accent">Request a feature</a>
          </div>
        )}
      </section>
    ))}
  </main>
</Base>

<style>
  .intro { padding: 35px 0 48px; }
  .intro .kicker { display: block; margin-bottom: 22px; }
  .page-h1 { max-width: 16ch; }
  .lede { max-width: 56ch; }

  /* scroll-margin clears the sticky header when the home page links straight to an app. */
  .app { padding: 40px 0; border-top: 1px solid var(--hairline); scroll-margin-top: 84px; }
  .app:last-child { padding-bottom: 80px; }

  .head { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; }
  h2 { margin: 0; font-size: 34px; line-height: 1.1; font-weight: 600; letter-spacing: -0.03em; }
  /* Badge and meta share one height and one centre line, so they sit level with the name. */
  .badge {
    display: inline-flex;
    align-items: center;
    height: 22px;
    padding: 0 8px;
    font-family: var(--mono);
    font-size: 11px;
    line-height: 1;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    border-radius: var(--r-control);
  }
  .available { color: var(--on-accent); background: var(--accent); }
  .dev { color: var(--accent); border: 1px solid var(--accent); }
  .meta {
    display: inline-flex;
    align-items: center;
    height: 22px;
    font-family: var(--mono);
    font-size: 11.5px;
    line-height: 1;
    color: var(--text-faint);
  }

  .desc { margin: 18px 0 0; font-size: 16px; line-height: 1.65; color: var(--text-muted); max-width: 62ch; }

  .features {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
    gap: 12px 34px;
    margin: 26px 0 30px;
    max-width: 860px;
    padding: 0;
    list-style: none;
  }
  .features li { font-size: 14.5px; line-height: 1.55; }

  .shots { display: flex; gap: 12px; overflow-x: auto; padding-bottom: 6px; }
  .shots :global(img) {
    width: 208px;
    height: auto;
    flex: none;
    border-radius: var(--r-card);
    border: 1px solid var(--hairline);
  }
  /* A shot pairs a dark and a light capture; the site's theme picks which one is shown. */
  .shots :global(.shot-light) { display: none; }
  :global([data-theme='light']) .shots :global(.shot-light) { display: block; }
  :global([data-theme='light']) .shots :global(.has-light) { display: none; }
  .caption { font-family: var(--mono); font-size: 11.5px; color: var(--text-faint); margin-top: 12px; }

  .ask {
    margin-top: 30px;
    border: 1px solid var(--hairline);
    border-radius: var(--r-card);
    padding: 22px;
    display: flex;
    gap: 20px;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
  }
  .ask-copy { font-family: var(--mono); font-size: 12px; line-height: 1.7; color: var(--text-muted); }

  /* The header wraps to two rows below 720px, so the anchor clears a taller bar. */
  @media (max-width: 720px) {
    .app { scroll-margin-top: 110px; }
  }

  @media (max-width: 560px) {
    .intro { padding: 35px 0 40px; }
    h2 { font-size: 28px; }
    .features { grid-template-columns: 1fr; }
  }
</style>
