---
import { Image } from 'astro:assets';
import Base from 'layouts/Base.astro';
import { APPS as REGISTRY, playUrl } from 'consts';

import galleryFolders from 'assets/gallery-folders.png';
import galleryFoldersLight from 'assets/gallery-folders-light.png';
import galleryGrid from 'assets/gallery-grid.png';
import galleryGridLight from 'assets/gallery-grid-light.png';
import galleryEdit from 'assets/gallery-edit.png';
import galleryEditLight from 'assets/gallery-edit-light.png';
import galleryMakeItYours from 'assets/gallery-make-it-yours.png';
import galleryMakeItYoursLight from 'assets/gallery-make-it-yours-light.png';

import playerLibrary from 'assets/player-library.png';
import playerLibraryLight from 'assets/player-library-light.png';
import playerAlbums from 'assets/player-albums.png';
import playerAlbumsLight from 'assets/player-albums-light.png';
import playerNowPlaying from 'assets/player-now-playing.png';
import playerNowPlayingLight from 'assets/player-now-playing-light.png';
import playerMakeItYours from 'assets/player-make-it-yours.png';
import playerMakeItYoursLight from 'assets/player-make-it-yours-light.png';

import recorderLibrary from 'assets/recorder-library.png';
import recorderLibraryLight from 'assets/recorder-library-light.png';
import recorderProject from 'assets/recorder-project.png';
import recorderProjectLight from 'assets/recorder-project-light.png';
import recorderEditor from 'assets/recorder-editor.png';
import recorderEditorLight from 'assets/recorder-editor-light.png';
import recorderSettings from 'assets/recorder-settings.png';
import recorderSettingsLight from 'assets/recorder-settings-light.png';

import filesRoot from 'assets/files-root.png';
import filesRootLight from 'assets/files-root-light.png';
import filesFolder from 'assets/files-folder.png';
import filesFolderLight from 'assets/files-folder-light.png';
import filesMarked from 'assets/files-marked.png';
import filesMarkedLight from 'assets/files-marked-light.png';
import filesSettings from 'assets/files-settings.png';
import filesSettingsLight from 'assets/files-settings-light.png';

const APPS = [
  {
    name: 'Gallery',
    available: true,
    tint: ['#718CFF', '#5A70CC'],
    mini: 'grid',
    meta: 'Photos & video · Android · under 5 MB',
    description:
      'A photo and video album that reads the pictures already on your phone, lays them out in the real folders they live in, and gets out of the way. The part most gallery apps cannot claim: it does not request the internet permission at all, so it cannot upload a photo, load an ad or phone home — not by promise, by construction. Check the permission list before you trust me.',
    features: [
      'Folder view that mirrors your phone',
      'Group by day or month, five sort keys',
      'Full-screen viewer, pinch zoom, video',
      'Details: size, dimensions, camera, EXIF',
      'Favourites, multi-select, hide folders',
      'Light, dark and pure black themes',
      'Five accents, custom colour, six app icons',
      '2–5 columns, radius, text size, contrast',
    ],
    shots: [
      { dark: galleryFolders, light: galleryFoldersLight, alt: 'Gallery for Android showing photo folders as they exist on the phone' },
      { dark: galleryGrid, light: galleryGridLight, alt: 'Gallery for Android showing one folder grouped by day' },
      { dark: galleryEdit, light: galleryEditLight, alt: 'Gallery for Android crop and rotate editor' },
      { dark: galleryMakeItYours, light: galleryMakeItYoursLight, alt: 'Gallery for Android theme, accent and layout settings' },
    ],
  },
  {
    name: 'Player',
    available: false,
    tint: ['#AD8DFF', '#8A70CC'],
    mini: 'eq',
    meta: 'Music · Android · under 5 MB',
    description:
      'A music player for the files already on your phone. It reads them where they sit, plays them in the background with a real notification, lock-screen controls and headset keys, and stops there — no catalogue to browse, no account, no recommendations. Like Gallery, it does not request the internet permission, so the music cannot go anywhere.',
    features: [
      'Tracks, albums, artists and playlists',
      'Background playback, lock screen, headset keys',
      'Queue: play next, add, reorder, shuffle',
      'Swipe the cover to change track, down to close',
      'Favourites, playlists, optional play history',
      'Sleep timer and synced .lrc lyrics',
      'Hide folders you do not want in the library',
      'Same themes, accents and app icons',
    ],
    shots: [
      { dark: playerLibrary, light: playerLibraryLight, alt: 'Player for Android showing the music library read from the phone' },
      { dark: playerAlbums, light: playerAlbumsLight, alt: 'Player for Android album view' },
      { dark: playerNowPlaying, light: playerNowPlayingLight, alt: 'Player for Android now playing screen with playback controls' },
      { dark: playerMakeItYours, light: playerMakeItYoursLight, alt: 'Player for Android appearance settings' },
    ],
    caption: 'Screens from the current build in progress.',
  },
  {
    name: 'Recorder',
    available: false,
    tint: ['#DEA858', '#B18646'],
    mini: 'wave',
    meta: 'Audio · Android',
    description:
      "A voice recorder that shows you the sound. Record with a live waveform and a running clock, drop a mark at the moment something matters, then trim, cut and fade afterwards without ever overwriting the original. Recordings are files on your phone in WAV, M4A or OPUS — not entries in someone's cloud.",
    features: [
      'Live waveform, dB meter, mono clock',
      'Marks while recording, 1× / 4× / 16× zoom',
      'Cut, split, fade — undoable until you save',
      'Record straight into a selection',
      'Playback 0.25× to 2×, −15s / +15s',
      'Optional projects, starred takes, search',
      'WAV / M4A / OPUS, voice to studio quality',
      'Same themes, accents and app icons',
    ],
    shots: [
      { dark: recorderLibrary, light: recorderLibraryLight, alt: 'Recorder for Android showing saved voice recordings' },
      { dark: recorderProject, light: recorderProjectLight, alt: 'Recorder for Android recording with a live waveform' },
      { dark: recorderEditor, light: recorderEditorLight, alt: 'Recorder for Android cut and fade editor' },
      { dark: recorderSettings, light: recorderSettingsLight, alt: 'Recorder for Android recording quality settings' },
    ],
    caption: 'Screens from the current build in progress.',
  },
  {
    name: 'Files',
    available: false,
    tint: ['#61BF8D', '#4D9870'],
    mini: 'panes',
    meta: 'File manager · Android',
    description:
      'A two-pane file manager, the way they used to be. Two folders open at once: mark what you want in the active pane, and copy or move goes into the other one. Portrait swipes between the panes; landscape shows both side by side. No file browser wants to be a homepage, so this one is a list, a footer and five buttons.',
    features: [
      'Copy, move, rename, delete, new folder',
      'Undo on the last operation',
      'Internal storage and SD card',
      'Filter, sort, folders-first, hidden files',
      'Comfortable or compact rows, kB or KiB',
      'Free space shown per pane',
    ],
    shots: [
      { dark: filesRoot, light: filesRootLight, alt: 'Files for Android showing internal storage in a two-pane layout' },
      { dark: filesFolder, light: filesFolderLight, alt: 'Files for Android browsing a folder' },
      { dark: filesMarked, light: filesMarkedLight, alt: 'Files for Android with files marked for copy' },
      { dark: filesSettings, light: filesSettingsLight, alt: 'Files for Android settings' },
    ],
    caption: 'Screens from the current build in progress.',
  },
];

// Null while an app is still in development.
const SECTIONS = APPS.map((app) => ({
  ...app,
  store: playUrl(REGISTRY.find((a) => a.name === app.name)?.playId ?? null),
}));
---

<Base
  page="mobile"
  title="Mobile apps — Gallery, Player, Recorder & Files"
  description="Gallery, Player, Recorder and Files. Free Android apps with no ads, no accounts and no tracking. Gallery is available; the rest are in development."
  pageType="CollectionPage"
  trail={[{ name: 'Mobile apps', path: '/mobile/' }]}
  apps
>
  <main class="shell">
    <section class="intro">
      <div class="copy">
        <div class="kicker">Mobile · 04</div>
        <h1 class="page-h1">Apps I use every day.</h1>
        <p class="lede">Android. Free. No ads, no accounts, no tracking, no in-app purchases — in all of them, not just the first one. Gallery is out; Player, Recorder and Files are in development.</p>
      </div>

      <nav class="index" aria-label="Jump to an app">
        {APPS.map((app, i) => (
          <a
            href={`#${app.name.toLowerCase()}`}
            class:list={['tile-link', { soon: !app.available }]}
            style={`--from: ${app.tint[0]}; --to: ${app.tint[1]}; --d: ${120 + i * 90}ms;`}
          >
            <span class="tile" aria-hidden="true">
              {app.mini === 'grid' && (
                <span class="mini grid">
                  {[0, 1, 2, 3, 4, 5, 6, 7, 8].map((n) => <span class="cell" style={`--i: ${n}`}></span>)}
                </span>
              )}
              {app.mini === 'eq' && (
                <span class="mini eq">
                  {[0, 1, 2, 3].map((n) => <span class="bar" style={`--i: ${n}`}></span>)}
                </span>
              )}
              {app.mini === 'wave' && (
                <span class="mini wave">
                  {[0, 1, 2, 3, 4, 5, 6].map((n) => <span class="bar" style={`--i: ${Math.abs(n - 3)}`}></span>)}
                </span>
              )}
              {app.mini === 'panes' && (
                <span class="mini panes">
                  <span class="pane"></span>
                  <span class="pane"></span>
                  <span class="chip"></span>
                </span>
              )}
            </span>
            <span class="tile-meta">
              <span class="tile-name">{app.name}</span>
              <span class="tile-status">{app.available ? 'Available' : 'In development'}</span>
            </span>
          </a>
        ))}
      </nav>
    </section>

    {SECTIONS.map((app) => (
      <section class="app" id={app.name.toLowerCase()}>
        <div class="head">
          <h2>{app.name}</h2>
          <span class:list={['badge', app.available ? 'available' : 'dev']}>
            {app.available ? 'Available' : 'In development'}
          </span>
          <span class="meta">{app.meta}</span>
        </div>
        <p class="desc">{app.description}</p>
        {app.store && (
          <a href={app.store} class="btn btn-accent store">
            Get {app.name} on Google Play
          </a>
        )}
        <ul class="features">
          {app.features.map((f) => <li>{f}</li>)}
        </ul>
        {app.shots.length > 0 && (
          <div class="shots">
            {app.shots.map(({ dark, light, alt }) => (
              <>
                <Image src={dark} alt={alt} width={416} densities={[1]} loading="lazy" class={light ? 'shot-dark has-light' : 'shot-dark'} />
                {/* Same screen in the light theme; CSS shows one or the other, so this
                    copy is decorative and must not be announced twice. */}
                {light && <Image src={light} alt="" width={416} densities={[1]} loading="lazy" class="shot-light" />}
              </>
            ))}
          </div>
        )}
        {app.caption && <div class="caption">{app.caption}</div>}
        {app.name === 'Files' && (
          <div class="ask">
            <div class="ask-copy">The build runs; the polish is next.<br />Tell me what a file manager must have and it goes in before release.</div>
            <a href="/contact/" class="btn btn-accent">Request a feature</a>
          </div>
        )}
      </section>
    ))}
  </main>
</Base>

<style>
  .intro { padding: 35px 0 44px; }
  .intro .kicker { display: block; margin-bottom: 22px; }
  .page-h1 { max-width: 16ch; }
  .lede { max-width: 56ch; }

  /*
    The four apps as an index: one tile each, in the app's own colour, running a small
    loop of the thing that app actually does — a grid of photos lighting up, a meter, a
    waveform, a file handed from one pane to the other. Each one links to its section.
  */
  .index {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
    margin-top: 24px;
  }
  .tile-link {
    display: flex;
    align-items: center;
    gap: 14px;
    animation: rise var(--t-enter) var(--enter) var(--d) backwards;
  }
  .tile {
    position: relative;
    width: 64px;
    flex: none;
    aspect-ratio: 1;
    border-radius: var(--r-tile);
    background: linear-gradient(150deg, var(--from), var(--to));
    display: grid;
    place-items: center;
    overflow: hidden;
    transition: transform var(--t-enter) var(--enter), opacity var(--t-enter) var(--enter);
  }
  /*
    The same two stops lit from the opposite corner. Crossfading to it on hover brightens
    the tile without moving it off the app's colour — and a gradient cannot be transitioned
    in place, so it has to be a second layer.
  */
  .tile::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(330deg, var(--from), var(--to));
    opacity: 0;
    transition: opacity var(--t-enter) var(--enter);
  }
  .tile-link:hover .tile { transform: translateY(-3px); }
  .tile-link:hover .tile::after { opacity: 1; }
  /* Three of the four are still being built; the tile says so before the label does. */
  .tile-link.soon .tile { opacity: 0.72; }
  .tile-link.soon:hover .tile { opacity: 1; }

  .tile-meta { display: grid; gap: 3px; min-width: 0; }
  .tile-name { font-size: 15px; font-weight: 500; }
  .tile-status {
    font-family: var(--mono);
    font-size: 9.5px;
    letter-spacing: 0.06em;
    white-space: nowrap;
    text-transform: uppercase;
    color: var(--text-faint);
  }
  .tile-link:not(.soon) .tile-status { color: var(--accent); }

  .mini { position: relative; z-index: 1; width: 46%; height: 46%; }
  .cell, .bar, .chip { background: rgba(255, 255, 255, 0.92); border-radius: 1.5px; }

  .grid { display: grid; grid-template-columns: repeat(3, 1fr); grid-template-rows: repeat(3, 1fr); gap: 10%; }
  .cell { opacity: 0.45; animation: cell-lit 3.6s var(--enter) calc(var(--i) * 230ms) infinite backwards; }
  @keyframes cell-lit { 0%, 100% { opacity: 0.4; } 45% { opacity: 1; } }

  .eq { display: flex; align-items: flex-end; gap: 9%; }
  .eq .bar { flex: 1; height: 100%; transform-origin: bottom; transform: scaleY(0.55); }
  /* Negative delays start each bar part-way in, so the four never move as one block. */
  .eq .bar { animation: eq-step 1.25s var(--enter) calc(var(--i) * -370ms) infinite alternate; }
  .eq .bar:nth-child(2) { animation-duration: 1.75s; }
  .eq .bar:nth-child(3) { animation-duration: 0.95s; }
  .eq .bar:nth-child(4) { animation-duration: 1.45s; }
  @keyframes eq-step { from { transform: scaleY(0.2); } to { transform: scaleY(1); } }

  .wave { display: flex; align-items: center; gap: 8%; }
  /* --i is the distance from the middle bar, so the pulse opens outwards from the centre. */
  .wave .bar {
    flex: 1;
    height: 100%;
    transform-origin: center;
    transform: scaleY(0.45);
    animation: wave-pulse 1.5s var(--enter) calc(var(--i) * 140ms) infinite alternate backwards;
  }
  @keyframes wave-pulse { from { transform: scaleY(0.16); } to { transform: scaleY(1); } }

  .panes { display: flex; align-items: center; gap: 14%; }
  .pane { flex: 1; height: 86%; border: 1px solid rgba(255, 255, 255, 0.82); border-radius: 2px; }
  .chip { position: absolute; left: 10%; top: 46%; width: 24%; height: 8%; animation: hand-off 3.4s var(--enter) infinite; }
  /* Across, a beat in the right pane, then out and back to the left unseen. */
  @keyframes hand-off {
    0%, 12% { transform: translateX(0); opacity: 1; }
    46%, 66% { transform: translateX(225%); opacity: 1; }
    76%, 84% { transform: translateX(225%); opacity: 0; }
    85% { transform: translateX(0); opacity: 0; }
    95%, 100% { transform: translateX(0); opacity: 1; }
  }

  /* scroll-margin clears the sticky header when the home page links straight to an app. */
  .app { padding: 40px 0; border-top: 1px solid var(--hairline); scroll-margin-top: 84px; }
  .app:last-child { padding-bottom: 80px; }

  .head { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; }
  h2 { margin: 0; font-size: 34px; line-height: 1.1; font-weight: 600; letter-spacing: -0.03em; }
  /* Badge and meta share one height and one centre line, so they sit level with the name. */
  .badge {
    display: inline-flex;
    align-items: center;
    height: 22px;
    padding: 0 8px;
    font-family: var(--mono);
    font-size: 11px;
    line-height: 1;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    border-radius: var(--r-control);
  }
  .available { color: var(--on-accent); background: var(--accent); }
  .dev { color: var(--accent); border: 1px solid var(--accent); }
  .meta {
    display: inline-flex;
    align-items: center;
    height: 22px;
    font-family: var(--mono);
    font-size: 11.5px;
    line-height: 1;
    color: var(--text-faint);
  }

  .desc { margin: 18px 0 0; font-size: 16px; line-height: 1.65; color: var(--text-muted); max-width: 62ch; }
  .store { margin-top: 22px; }

  .features {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
    gap: 12px 34px;
    margin: 26px 0 30px;
    max-width: 860px;
    padding: 0;
    list-style: none;
  }
  .features li { font-size: 14.5px; line-height: 1.55; }

  .shots { display: flex; gap: 12px; overflow-x: auto; padding-bottom: 6px; }
  .shots :global(img) {
    width: 208px;
    height: auto;
    flex: none;
    border-radius: var(--r-card);
    border: 1px solid var(--hairline);
  }
  /* A shot pairs a dark and a light capture; the site's theme picks which one is shown. */
  .shots :global(.shot-light) { display: none; }
  :global([data-theme='light']) .shots :global(.shot-light) { display: block; }
  :global([data-theme='light']) .shots :global(.has-light) { display: none; }
  .caption { font-family: var(--mono); font-size: 11.5px; color: var(--text-faint); margin-top: 12px; }

  .ask {
    margin-top: 30px;
    border: 1px solid var(--hairline);
    border-radius: var(--r-card);
    padding: 22px;
    display: flex;
    gap: 20px;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
  }
  .ask-copy { font-family: var(--mono); font-size: 12px; line-height: 1.7; color: var(--text-muted); }

  /* The header wraps to two rows below 720px, so the anchor clears a taller bar. */
  @media (max-width: 720px) {
    .app { scroll-margin-top: 110px; }
  }

  /*
    The row stays four across at every width. Once the label no longer fits beside its
    tile it goes under it instead, and the status is allowed to wrap onto a second line.
  */
  @media (max-width: 700px) {
    .index { gap: 14px; }
    .tile-link { display: block; }
    .tile { width: 100%; max-width: 64px; margin-bottom: 10px; }
    .tile-status { white-space: normal; font-size: 9px; }
  }

  @media (max-width: 560px) {
    .intro { padding: 35px 0 40px; }
    .index { margin-top: 36px; gap: 10px; }
    .tile-name { font-size: 13.5px; }
    h2 { font-size: 28px; }
    .features { grid-template-columns: 1fr; }
  }
</style>
