---
import Base from 'layouts/Base.astro';

const PALETTE = [
  ['#718CFF', '#5A70CC'], // blue
  ['#DEA858', '#B18646'], // amber
  ['#61BF8D', '#4D9870'], // green
  ['#D96B8B', '#AD556F'], // pink
  ['#AD8DFF', '#8A70CC'], // purple
];

// A 5x7 pixel face per digit; the two are stitched into 17-column rows with one blank
// column between them, and every '#' becomes a gradient tile.
const FOUR = ['...#.', '..##.', '.#.#.', '#..#.', '#####', '...#.', '...#.'];
const ZERO = ['.###.', '#...#', '#..##', '#.#.#', '##..#', '#...#', '.###.'];

// The furthest tile from the origin of the wave: last row plus last column.
const LAST = FOUR.length - 1 + 16;

const CELLS = FOUR.map((_, row) => `${FOUR[row]}.${ZERO[row]}.${FOUR[row]}`)
  .flatMap((line, row) =>
    [...line].map((mark, col) => ({
      // The palette is walked along the diagonal, so the colour bands and the animation
      // wave travel together across the number.
      gradient: PALETTE[(row + col) % PALETTE.length],
      // Two waves over the same diagonal: one counting up for the entrance, one
      // counting down so the number dissolves from its far corner instead.
      in: (row + col) * 22,
      out: (LAST - row - col) * 15,
      lit: mark === '#',
    })),
  )
  .filter((cell) => cell.lit);

const LINKS = [
  ['/', 'Home', 'The whole idea, in four lines.'],
  ['/apps', 'Apps', 'Gallery, Player, Recorder and Files.'],
  ['/privacy', 'Privacy', 'The short version: nothing is collected.'],
  ['/contact', 'Contact', 'Tell me what you were looking for.'],
];
---

<Base
  title="Page not found — Simplify my app"
  description="That page does not exist. The apps, the privacy policy and the inbox all still do."
>
  <main class="shell">
    <section class="top">
      <div class="copy">
        <div class="kicker">Error · 404</div>
        <h1 class="page-h1">This one got simplified a little too far.</h1>
        <p class="lede">There is no page at that address. Nothing was removed to spite you — it was probably never here. The apps, the privacy policy and the inbox all still are.</p>
        <p class="path"><span>GET</span> <code id="path">/the-page-you-asked-for</code> <span class="code-404">404</span></p>
        <div class="actions">
          <a href="/" class="btn btn-accent">Back to the start</a>
          <button id="simplify" type="button" class="btn btn-quiet" aria-controls="mosaic">Simplify it</button>
        </div>
      </div>

      <div class="stage">
        <div id="mosaic" class="mosaic" role="img" aria-label="404">
          {CELLS.map((cell) => (
            <span
              class="tile"
              style={`--from: ${cell.gradient[0]}; --to: ${cell.gradient[1]}; --in: ${cell.in}ms; --out: ${cell.out}ms;`}
            ></span>
          ))}
        </div>
        <p class="note" aria-hidden="true">there. nothing<br />left to load.</p>
      </div>
    </section>

    <section class="rest">
      <h2 class="kicker">Somewhere that does exist</h2>
      <div class="links">
        {LINKS.map(([href, label, blurb]) => (
          <a href={href} class="link-row">
            <span class="link-name">{label}</span>
            <span class="link-blurb">{blurb}</span>
            <span class="link-go" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </section>
  </main>
</Base>

<style>
  .top {
    padding: 35px 0 84px;
    display: grid;
    grid-template-columns: minmax(300px, 1.05fr) minmax(260px, 0.8fr);
    gap: 48px;
    align-items: center;
  }
  .copy .kicker { display: block; margin-bottom: 22px; }
  .page-h1 { max-width: 15ch; }
  .lede { max-width: 50ch; }

  .path {
    margin: 26px 0 0;
    font-family: var(--mono);
    font-size: 12.5px;
    color: var(--text-faint);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
  }
  .path code {
    /* The requested path is arbitrary and can be long; let it clip rather than push the
       column wider than its track. */
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    padding: 4px 8px;
    border-radius: var(--r-control);
    background: var(--surface-alt);
    color: var(--text-muted);
  }
  .code-404 { color: var(--accent); }

  .actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 32px; }

  .stage { position: relative; justify-self: center; }

  .mosaic {
    --cell: clamp(9px, 3.4vw, 19px);
    --gap: clamp(3px, 0.9vw, 5px);
    display: grid;
    grid-template-columns: repeat(17, var(--cell));
    gap: var(--gap);
  }

  .tile {
    aspect-ratio: 1;
    border-radius: 3px;
    background: linear-gradient(150deg, var(--from), var(--to));
    /* backwards, not forwards: once the entrance is over the tile is back on its own
       base style, which is what lets the transition below take over on the toggle. */
    animation: tile-in var(--t-enter) var(--enter) var(--in) backwards;
    transition:
      opacity var(--t-enter) var(--exit) var(--out),
      transform var(--t-enter) var(--exit) var(--out);
  }

  @keyframes tile-in {
    from { opacity: 0; transform: translateY(7px) scale(0.55); }
  }

  .mosaic.is-simplified .tile { opacity: 0; transform: scale(0.4); }

  .note {
    position: absolute;
    inset: 0;
    margin: 0;
    display: grid;
    place-content: center;
    text-align: center;
    font-family: var(--hand);
    font-size: clamp(24px, 5vw, 34px);
    line-height: 1.15;
    color: var(--text-muted);
    opacity: 0;
    pointer-events: none;
    transform: rotate(-3deg);
    transition: opacity var(--t-enter) var(--enter);
  }
  .mosaic.is-simplified + .note { opacity: 1; transition-delay: 420ms; }

  .rest { padding: 0 0 90px; }
  .rest h2 { margin: 0 0 18px; }

  .links {
    display: grid;
    gap: 1px;
    background: var(--hairline);
    border: 1px solid var(--hairline);
    border-radius: var(--r-card);
    overflow: hidden;
  }
  .link-row {
    background: var(--bg);
    padding: 20px 22px;
    display: grid;
    grid-template-columns: 110px 1fr auto;
    gap: 18px;
    align-items: baseline;
    transition: background var(--t-state) var(--enter);
  }
  .link-row:hover { background: var(--surface); color: inherit; }
  .link-name { font-size: 16px; font-weight: 500; }
  .link-blurb { font-size: 14.5px; line-height: 1.6; color: var(--text-muted); }
  .link-go { color: var(--text-faint); transition: color var(--t-state) var(--enter); }
  .link-row:hover .link-go { color: var(--accent); }

  @media (max-width: 860px) {
    .top { grid-template-columns: 1fr; gap: 44px; padding-bottom: 64px; }
    .stage { justify-self: start; }
  }

  @media (max-width: 560px) {
    .link-row { grid-template-columns: 1fr auto; row-gap: 8px; padding: 18px; }
    .link-blurb { grid-column: 1 / -1; }
  }
</style>

<script>
  // astro:page-load fires on first load and after every router swap, which replaces the
  // elements bound here. The module itself only runs once.
  document.addEventListener('astro:page-load', () => {
    const path = document.getElementById('path');
    const mosaic = document.getElementById('mosaic');
    const button = document.getElementById('simplify') as HTMLButtonElement | null;
    if (!path || !mosaic || !button) return;

    // The 404 is served for an address Astro never rendered a page for, so the real one
    // is only knowable here.
    const asked = location.pathname + location.search;
    if (asked !== '/404' && asked !== '/404/') path.textContent = asked;

    button.addEventListener('click', () => {
      const gone = mosaic.classList.toggle('is-simplified');
      button.textContent = gone ? 'Put it back' : 'Simplify it';
      mosaic.setAttribute('aria-label', gone ? 'Nothing left to load' : '404');
    });
  });
</script>
